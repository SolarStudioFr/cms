# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Tests assert on mailer.message_logger_listener (framework.test's mailer
# collector), never on actually-delivered mail - no need for the real
# Mailpit round-trip the dev env uses (step 22), and skipping it keeps the
# suite hermetic/fast.
MAILER_DSN=null://null
